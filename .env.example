# Public URL used by the browser. Set this to your deployed HTTPS address.
APP_ORIGIN=http://localhost:5173
PORT=3001
SESSION_SECRET=replace-with-a-long-random-value
# Required to encrypt the remembered mailbox details at rest. Use a different long random value.
MAIL_ENCRYPTION_KEY=replace-with-a-different-long-random-value

# Leave these blank to let each Vedøy user securely connect their own mailbox.
# Alternatively set them to lock the installation to a managed shared mailbox.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_TLS=true

# Optional: enables AI-assisted reply drafts. It can also be added securely in the app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
